# Copy/setup privately; never use EXPO_PUBLIC_ for secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Run pnpm ai:setup to create a separate random server token.
AI_SERVER_TOKEN=
AI_HOST=127.0.0.1
AI_PORT=8787
# For phone testing on a trusted private LAN only: AI_HOST=0.0.0.0 and true below.
AI_ALLOW_LAN_HTTP=false
